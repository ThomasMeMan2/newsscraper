# LLM API Keys (only one is required - based on llm_provider in settings.yaml)
# Default provider is OpenAI. Switch by changing llm_provider in settings.yaml

# OpenAI (default)
OPENAI_API_KEY=sk-xxxxx

# Anthropic Claude (alternative)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Google Gemini (alternative)
GEMINI_API_KEY=xxxxx

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# Optional: Override database path
# DATABASE_PATH=/custom/path/to/news.db
